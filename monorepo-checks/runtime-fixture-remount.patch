@@ -1,14 +1,173 @@
 package expo.modules.benchmarkhelper
 
+import android.app.Activity
+import android.app.Application
+import android.content.Context
+import android.os.Bundle
+import android.os.Process
+import android.widget.LinearLayout
+import android.widget.TextView
+import expo.modules.kotlin.AppContext
 import expo.modules.kotlin.modules.Module
 import expo.modules.kotlin.modules.ModuleDefinition
+import expo.modules.kotlin.views.ExpoView
+import java.util.concurrent.ConcurrentHashMap
+import java.util.concurrent.atomic.AtomicBoolean
+import java.util.concurrent.atomic.AtomicInteger
 
 class BenchmarkHelperModule : Module() {
+  private val probeInstance = nextProbeInstance.incrementAndGet()
+
   override fun definition() = ModuleDefinition {
     Name("BenchmarkHelperModule")
 
+    OnCreate {
+      val activity = requireNotNull(appContext.currentActivity) {
+        "Registry probe module was created without a current Activity"
+      }
+      watchedActivityIds.add(System.identityHashCode(activity))
+      val reactContext = requireNotNull(appContext.reactContext) {
+        "Registry probe module was created without a ReactContext"
+      }
+      val application = requireNotNull(reactContext.applicationContext as? Application) {
+        "Registry probe could not resolve the Android Application"
+      }
+      registerProbeLifecycleCallbacks(application)
+    }
+
     Function("reportFullyDrawn") {
       BenchmarkManager.reportFullyDrawn(appContext.currentActivity)
     }
+
+    Function("getRegistryProbeContext") {
+      val activity = requireNotNull(appContext.currentActivity) {
+        "Registry probe snapshot requires a current Activity"
+      }
+      val reactContext = requireNotNull(appContext.reactContext) {
+        "Registry probe snapshot requires a ReactContext"
+      }
+      mapOf(
+        "pid" to Process.myPid(),
+        "moduleInstance" to probeInstance,
+        "appContext" to System.identityHashCode(appContext),
+        "reactContext" to System.identityHashCode(reactContext),
+        "activity" to System.identityHashCode(activity)
+      )
+    }
+
+    Function("getSplashLifecycleProbe") {
+      val activity = requireNotNull(appContext.currentActivity) {
+        "Splash lifecycle snapshot requires a current Activity"
+      }
+      check(lifecycleCallbacksInstalled.get()) {
+        "Splash lifecycle probe callback is not installed"
+      }
+      mapOf(
+        "probeCallbacksInstalled" to lifecycleCallbacksInstalled.get(),
+        "currentActivity" to System.identityHashCode(activity),
+        "destroyCount" to destroyedActivityCount.get(),
+        "lastDestroyedActivity" to lastDestroyedActivityId,
+        "splashOwnerWasClearedOnDestroy" to splashOwnerClearedOnLastDestroy,
+        "splashOwnerPresentNow" to isSplashOwnerPresent()
+      )
+    }
+
+    Function("recreateActivity") {
+      val activity = requireNotNull(appContext.currentActivity) {
+        "Activity recreation probe requires a current Activity"
+      }
+      activity.runOnUiThread { activity.recreate() }
+      System.identityHashCode(activity)
+    }
+
+    View(RegistryProbeView::class) {
+      Prop("values") { view: RegistryProbeView, values: List<Int> ->
+        view.setProbeValues(values)
+      }.asStateProp()
+
+      Prop("label") { view: RegistryProbeView, label: String ->
+        view.setProbeLabel(label)
+      }
+    }
+  }
+
+  companion object {
+    private val nextProbeInstance = AtomicInteger()
+    private val lifecycleCallbacksInstalled = AtomicBoolean()
+    private val watchedActivityIds = ConcurrentHashMap.newKeySet<Int>()
+    private val destroyedActivityCount = AtomicInteger()
+
+    @Volatile
+    private var lastDestroyedActivityId = 0
+
+    @Volatile
+    private var splashOwnerClearedOnLastDestroy = false
+
+    private fun registerProbeLifecycleCallbacks(application: Application) {
+      if (!lifecycleCallbacksInstalled.compareAndSet(false, true)) {
+        return
+      }
+
+      application.registerActivityLifecycleCallbacks(object : Application.ActivityLifecycleCallbacks {
+        override fun onActivityCreated(activity: Activity, savedInstanceState: Bundle?) {
+          if (activity.javaClass.name == "dev.expo.payments.MainActivity") {
+            watchedActivityIds.add(System.identityHashCode(activity))
+          }
+        }
+
+        override fun onActivityStarted(activity: Activity) {}
+        override fun onActivityResumed(activity: Activity) {}
+        override fun onActivityPaused(activity: Activity) {}
+        override fun onActivityStopped(activity: Activity) {}
+        override fun onActivitySaveInstanceState(activity: Activity, outState: Bundle) {}
+
+        override fun onActivityDestroyed(activity: Activity) {}
+
+        override fun onActivityPostDestroyed(activity: Activity) {
+          val identity = System.identityHashCode(activity)
+          if (!watchedActivityIds.contains(identity)) {
+            return
+          }
+          lastDestroyedActivityId = identity
+          splashOwnerClearedOnLastDestroy = !isSplashOwnerPresent()
+          destroyedActivityCount.incrementAndGet()
+        }
+      })
+    }
+
+    private fun isSplashOwnerPresent(): Boolean {
+      val managerClass = Class.forName("expo.modules.splashscreen.SplashScreenManager")
+      val manager = managerClass.getDeclaredField("INSTANCE").get(null)
+      val field = managerClass.getDeclaredField("splashScreen")
+      field.isAccessible = true
+      return field.get(manager) != null
+    }
+  }
+}
+
+class RegistryProbeView(context: Context, appContext: AppContext) : ExpoView(context, appContext) {
+  override val shouldUseAndroidLayout = true
+  private val output = TextView(context)
+  private var probeLabel = "unset"
+  private var probeValues = "unset"
+
+  init {
+    addView(output, LinearLayout.LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.WRAP_CONTENT))
+    renderProbe()
+  }
+
+  fun setProbeValues(values: List<Int>) {
+    probeValues = values.joinToString(prefix = "[", postfix = "]")
+    renderProbe()
+  }
+
+  fun setProbeLabel(label: String) {
+    probeLabel = label
+    renderProbe()
+  }
+
+  private fun renderProbe() {
+    output.text = "$probeLabel: $probeValues"
+    output.contentDescription = "native registry probe $probeLabel: $probeValues"
   }
 }
